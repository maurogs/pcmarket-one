<%= turbo_stream.replace dom_id(@listing, :favorite_compact), partial: "favorites/button", locals: { listing: @listing, compact: true } %>
<%= turbo_stream.replace dom_id(@listing, :favorite), partial: "favorites/button", locals: { listing: @listing, compact: false } %>
<%= turbo_stream.update dom_id(@listing, :watchers), t("listings.show.watchers", count: @listing.favorites_count) %>
