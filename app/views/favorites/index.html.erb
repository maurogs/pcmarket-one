<% seo title: t(".title"), noindex: true %>
<div class="container-page py-8">
  <h1 class="section-title"><%= t(".title") %></h1>
  <% if @listings.any? %>
    <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
      <% @listings.each do |listing| %><%= render "listings/card", listing: listing, show_specs: false %><% end %>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <%= render "shared/empty_state", icon_name: :heart, title: t(".empty_title"), body: t(".empty_body"), cta: [t(".browse"), listings_path] %>
  <% end %>
</div>
