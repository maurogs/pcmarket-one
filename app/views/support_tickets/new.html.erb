<% seo title: t(".title"), description: t(".subtitle") %>
<div class="container-page max-w-2xl py-10">
  <h1 class="section-title"><%= t(".title") %></h1>
  <p class="mt-2 text-ink-600 dark:text-ink-300"><%= t(".subtitle") %></p>
  <%= form_with model: @ticket, url: support_tickets_path, class: "panel mt-6 space-y-4" do |f| %>
    <% if @ticket.errors.any? %><p class="field-error" role="alert"><%= @ticket.errors.full_messages.to_sentence %></p><% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true, autocomplete: "name" %></div>
      <div><%= f.label :email, class: "label" %><%= f.email_field :email, class: "input", required: true, autocomplete: "email" %></div>
    </div>
    <div><%= f.label :topic, class: "label" %><%= f.select :topic, SupportTicket.topics.keys.map { |k| [t("support_tickets.topics.#{k}"), k] }, {}, class: "input" %></div>
    <div><%= f.label :subject, class: "label" %><%= f.text_field :subject, class: "input", required: true, maxlength: 150 %></div>
    <div><%= f.label :body, class: "label" %><%= f.text_area :body, rows: 6, class: "input", required: true, maxlength: 5000 %></div>
    <p class="text-xs text-ink-500"><%= t(".privacy_html", link: link_to(t("legal.privacy.title"), legal_page_path("privacy"), class: "underline")) %></p>
    <button class="btn-primary w-full"><%= t(".submit") %></button>
  <% end %>
</div>
