<% seo title: t(".title"), noindex: true %>
<div class="container-page py-8">
  <h1 class="section-title"><%= t(".title") %></h1>
  <div class="mt-6 flex flex-col gap-6 lg:flex-row">
    <%= render "shared/account_nav", section: :account %>
    <%= form_with model: current_user, url: account_profile_path, method: :patch, class: "panel flex-1 space-y-4" do |f| %>
      <% if current_user.errors.any? %><p class="field-error" role="alert"><%= current_user.errors.full_messages.to_sentence %></p><% end %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= f.label :first_name, class: "label" %><%= f.text_field :first_name, class: "input", autocomplete: "given-name" %></div>
        <div><%= f.label :last_name, class: "label" %><%= f.text_field :last_name, class: "input", autocomplete: "family-name" %></div>
        <div><%= f.label :username, class: "label" %><%= f.text_field :username, class: "input", required: true %><p class="hint"><%= t(".username_hint") %></p></div>
        <div><%= f.label :phone, class: "label" %><%= f.telephone_field :phone, class: "input", autocomplete: "tel" %></div>
        <div><%= f.label :region_id, class: "label" %><%= f.collection_select :region_id, current_country.regions, :id, :name, { include_blank: true }, class: "input" %></div>
        <div><%= f.label :city, class: "label" %><%= f.text_field :city, class: "input" %></div>
        <div><%= f.label :locale, class: "label" %><%= f.select :locale, enabled_locales.map { |l| [t("locales.#{l}"), l] }, {}, class: "input" %></div>
        <div><%= f.label :avatar, class: "label" %><%= f.file_field :avatar, accept: "image/*", class: "input py-2" %></div>
      </div>
      <div><%= f.label :bio, class: "label" %><%= f.text_area :bio, rows: 3, maxlength: 1000, class: "input" %></div>
      <p class="text-sm text-ink-500"><%= t(".email_html", email: current_user.email, link: link_to(t("account.nav.security"), edit_user_registration_path, class: "link")) %></p>
      <div class="flex justify-end"><button class="btn-primary"><%= t("shared.save") %></button></div>
    <% end %>
  </div>
</div>
