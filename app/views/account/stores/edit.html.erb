<% seo title: t(".title"), noindex: true %>
<div class="container-page py-8">
  <h1 class="section-title"><%= t(".title") %></h1>
  <div class="mt-6 flex flex-col gap-6 lg:flex-row">
    <%= render "shared/account_nav", section: :seller %>
    <%= form_with model: current_user, url: account_store_path, method: :patch, class: "flex-1 space-y-6" do |f| %>
      <% if current_user.errors.any? %><p class="field-error" role="alert"><%= current_user.errors.full_messages.to_sentence %></p><% end %>
      <section class="panel space-y-4">
        <h2 class="font-display text-lg font-bold"><%= t(".branding") %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><%= f.label :store_name, class: "label" %><%= f.text_field :store_name, class: "input", maxlength: 60 %></div>
          <div><%= f.label :store_tagline, class: "label" %><%= f.text_field :store_tagline, class: "input", maxlength: 140 %></div>
          <div><%= f.label :store_logo, class: "label" %><%= f.file_field :store_logo, accept: "image/*", class: "input py-2" %><p class="hint"><%= t(".logo_hint") %></p></div>
          <div><%= f.label :store_banner, class: "label" %><%= f.file_field :store_banner, accept: "image/*", class: "input py-2" %><p class="hint"><%= t(".banner_hint") %></p></div>
        </div>
        <div><%= f.label :bio, t(".about"), class: "label" %><%= f.text_area :bio, rows: 3, class: "input", maxlength: 1000 %></div>
      </section>
      <section class="panel space-y-4">
        <h2 class="font-display text-lg font-bold"><%= t(".policies") %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><%= f.label :return_window_days, class: "label" %><%= f.select :return_window_days, [0, 14, 30, 60].map { |d| [d.zero? ? t(".no_returns") : t(".days", count: d), d] }, {}, class: "input" %><p class="hint"><%= t(".returns_hint") %></p></div>
          <label class="flex items-center gap-2 self-center text-sm"><%= f.check_box :allow_offers_default, class: "checkbox" %><%= t(".allow_offers_default") %></label>
        </div>
        <div><%= f.label :store_policies, class: "label" %><%= f.text_area :store_policies, rows: 4, class: "input", maxlength: 3000 %></div>
      </section>
      <section class="panel space-y-4">
        <h2 class="font-display text-lg font-bold"><%= t(".seller_status") %></h2>
        <p class="text-sm text-ink-600 dark:text-ink-300"><%= t(".seller_status_hint") %></p>
        <div class="grid gap-2 sm:grid-cols-2">
          <% User.seller_types.each_key do |type| %>
            <label class="flex cursor-pointer gap-2 rounded-xl border border-ink-200 p-3 text-sm has-[:checked]:border-brand-600 dark:border-ink-700"><%= f.radio_button :seller_type, type, class: "checkbox mt-0.5" %><span><strong><%= t("stores.seller_types.#{type}") %></strong><br><span class="text-ink-500"><%= t(".seller_type_hint.#{type}") %></span></span></label>
          <% end %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><%= f.label :legal_name, t(".legal_name"), class: "label" %><%= f.text_field :legal_name, class: "input" %></div>
          <div><%= f.label :tax_id, t(".tax_id"), class: "label" %><%= f.text_field :tax_id, class: "input" %></div>
          <div><%= f.label :business_address, t(".business_address"), class: "label" %><%= f.text_field :business_address, class: "input" %></div>
          <div><%= f.label :trade_register_number, t(".trade_register_number"), class: "label" %><%= f.text_field :trade_register_number, class: "input" %></div>
        </div>
        <% if current_user.business? %>
          <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="trader_certification" value="1" class="checkbox mt-0.5" <%= "checked" if current_user.trader_certified_at %>> <%= t(".trader_certification") %></label>
        <% end %>
        <p class="text-xs text-ink-500"><%= t(".dac7_notice") %></p>
      </section>
      <div class="flex justify-end"><button class="btn-primary"><%= t("shared.save") %></button></div>
    <% end %>
  </div>
</div>
