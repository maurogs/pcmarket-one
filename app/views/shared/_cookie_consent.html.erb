  <section class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-2xl rounded-2xl border border-ink-200 bg-white p-5 shadow-2xl sm:inset-x-6 dark:border-ink-700 dark:bg-ink-900" data-cookie-consent-target="banner" role="dialog" aria-labelledby="cookie-title" aria-live="polite" hidden>
    <h2 id="cookie-title" class="font-display text-lg font-bold"><%= t("cookies.title") %></h2>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-300"><%= t("cookies.body_html", link: link_to(t("legal.cookies.title"), legal_page_path("cookies"), class: "link")) %></p>
    <div class="mt-3 space-y-2 text-sm" data-cookie-consent-target="details" hidden>
      <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" checked disabled> <%= t("cookies.necessary") %></label>
      <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" data-cookie-consent-target="analytics"> <%= t("cookies.analytics") %></label>
      <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" data-cookie-consent-target="marketing"> <%= t("cookies.marketing") %></label>
    </div>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" class="btn-primary btn-sm" data-action="cookie-consent#acceptAll"><%= t("cookies.accept_all") %></button>
      <button type="button" class="btn-outline btn-sm" data-action="cookie-consent#rejectAll"><%= t("cookies.reject_all") %></button>
      <button type="button" class="btn-ghost btn-sm" data-action="cookie-consent#customize" data-cookie-consent-target="customizeButton"><%= t("cookies.customize") %></button>
      <button type="button" class="btn-ghost btn-sm" data-action="cookie-consent#save" data-cookie-consent-target="saveButton" hidden><%= t("cookies.save") %></button>
    </div>
  </section>
