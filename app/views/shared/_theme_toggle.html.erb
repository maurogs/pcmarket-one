<button type="button" class="chip" data-action="theme#toggle" aria-label="<%= t("layout.toggle_theme") %>">
  <%= icon(:sun, css: "size-3.5 dark:hidden") %><%= icon(:moon, css: "hidden size-3.5 dark:block") %>
  <span class="dark:hidden"><%= t("layout.light") %></span><span class="hidden dark:inline"><%= t("layout.dark") %></span>
</button>
