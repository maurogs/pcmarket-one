<footer class="mt-16 border-t border-ink-200 bg-ink-50 dark:border-ink-800 dark:bg-ink-900">
  <div class="container-page grid gap-10 py-12 lg:grid-cols-[1.3fr_2fr]">
    <div>
      <%= link_to root_path, class: "flex items-center gap-2" do %><%= render "shared/logo", css: "size-8" %><span class="font-display text-xl font-bold"><%= site_name %></span><% end %>
      <p class="mt-3 max-w-sm text-sm text-ink-600 dark:text-ink-300"><%= t("layout.footer.tagline") %></p>
      <% if feature?(:newsletter_enabled) %>
        <div class="mt-6 rounded-2xl border border-ink-200 bg-white p-5 dark:border-ink-700 dark:bg-ink-950">
          <h2 class="font-display text-lg font-bold"><%= t("layout.footer.newsletter_title") %></h2>
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300"><%= t("layout.footer.newsletter_body") %></p>
          <%= form_with url: newsletter_subscriptions_path, class: "mt-3 flex gap-2" do %>
            <label for="newsletter-email" class="sr-only"><%= t("layout.footer.email") %></label>
            <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="<%= t("layout.footer.email") %>" class="input">
            <button class="btn-primary shrink-0"><%= t("layout.footer.subscribe") %></button>
          <% end %>
          <p class="mt-2 text-[11px] text-ink-500"><%= t("layout.footer.newsletter_legal_html", privacy: link_to(t("legal.privacy.title"), legal_page_path("privacy"), class: "underline")) %></p>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      <div>
        <h2 class="font-display text-base font-bold"><%= t("layout.footer.about") %></h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-300">
          <li><%= link_to t("layout.footer.about_us"), page_path("about"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.trust"), trust_path, class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.footer.how_it_works"), page_path("how-it-works"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.footer.credits"), page_path("credits"), class: "hover:text-brand-700" %></li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-base font-bold"><%= t("layout.footer.buy_sell") %></h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-300">
          <li><%= link_to t("layout.sell_info"), sell_info_path, class: "hover:text-brand-700" %></li>
          <% if feature?(:sell_to_us_enabled) %><li><%= link_to t("layout.sell_to_us"), new_buyback_request_path, class: "hover:text-brand-700" %></li><% end %>
          <% if feature?(:pc_finder_enabled) %><li><%= link_to t("layout.pc_finder"), pc_finder_path, class: "hover:text-brand-700" %></li><% end %>
          <li><%= link_to t("layout.footer.fees"), page_path("fees"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.footer.shipping_guide"), page_path("shipping-guide"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.footer.photo_guide"), page_path("photo-guide"), class: "hover:text-brand-700" %></li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-base font-bold"><%= t("layout.footer.help") %></h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-600 dark:text-ink-300">
          <li><%= link_to t("layout.help"), page_path("help"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("layout.footer.contact"), new_support_ticket_path, class: "hover:text-brand-700" %></li>
          <li><a href="mailto:<%= setting(:support_email) %>" class="hover:text-brand-700"><%= setting(:support_email) %></a></li>
          <li><%= link_to t("legal.returns.title"), legal_page_path("returns"), class: "hover:text-brand-700" %></li>
          <li><%= link_to t("legal.buyer_protection.title"), legal_page_path("buyer-protection"), class: "hover:text-brand-700" %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-ink-200 dark:border-ink-800">
    <div class="container-page flex flex-col gap-4 py-6 text-xs text-ink-500 lg:flex-row lg:items-center lg:justify-between">
      <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="<%= t("layout.footer.legal_nav") %>">
        <% %w[terms privacy cookies legal_notice seller_terms prohibited_items dsa accessibility].each do |slug| %>
          <%= link_to t("legal.#{slug}.title"), legal_page_path(slug.tr("_", "-")), class: "hover:text-brand-700" %>
        <% end %>
        <button type="button" class="hover:text-brand-700" data-action="cookie-consent#reopen"><%= t("layout.footer.cookie_preferences") %></button>
      </nav>
      <div class="flex flex-wrap items-center gap-3">
        <%= render "shared/locale_switcher" %>
        <%= render "shared/country_switcher" %>
        <%= render "shared/theme_toggle" if feature?(:dark_mode_enabled) %>
      </div>
    </div>
    <p class="container-page pb-6 text-xs text-ink-500"><%= t("layout.footer.copyright", year: Date.current.year, company: LegalFacts.for(current_country.code)["company_name"]) %></p>
  </div>
</footer>
