<%# locals: (listing:, eager: false, show_specs: true) %>
<article class="group relative flex flex-col">
  <div class="relative aspect-[6/5] overflow-hidden rounded-2xl bg-ink-100 dark:bg-ink-800">
    <%= link_to listing_path(listing), class: "block h-full", tabindex: -1, aria: { hidden: true } do %>
      <%= listing_image(listing, eager: eager, css: "transition duration-300 group-hover:scale-[1.03] #{'opacity-60 grayscale' if listing.sold?}", sizes: "(min-width: 1024px) 25vw, 50vw") %>
    <% end %>
    <div class="pointer-events-none absolute left-2.5 top-2.5 flex flex-wrap gap-1"><%= listing_badge(listing) %></div>
    <% if listing.promoted? && feature?(:promotions_enabled) %>
      <span class="badge-muted absolute bottom-2.5 left-2.5"><%= t("listings.badges.promoted") %></span>
    <% end %>
    <%= render "favorites/button", listing: listing, compact: true %>
  </div>
  <div class="mt-3 flex flex-1 flex-col">
    <h3 class="line-clamp-2 text-sm font-semibold leading-snug">
      <%= link_to listing.title, listing_path(listing), class: "after:absolute after:inset-0 after:content-[''] hover:text-brand-700 dark:hover:text-brand-300" %>
    </h3>
    <p class="mt-1">
      <% if listing.sold? %>
        <span class="text-xs font-semibold uppercase text-ink-500"><%= t("listings.card.sold_for") %></span> <span class="font-bold"><%= money(listing.price_cents, listing.currency) %></span>
      <% else %>
        <%= price_tag(listing, css: "text-base") %>
      <% end %>
    </p>
    <p class="mt-0.5 flex items-center gap-1 truncate text-xs text-ink-500 dark:text-ink-400">
      <span class="truncate"><%= listing.user.display_name %></span>
      <% if listing.user.verified? %><%= icon(:verified, css: "size-3.5 shrink-0 text-brand-600", label: t("stores.verified")) %><% end %>
      <% if listing.user.business? %><span class="sr-only"><%= t("stores.business") %></span><%= icon(:store, css: "size-3.5 shrink-0 text-ink-400") %><% end %>
    </p>
    <% if show_specs && (specs = listing.card_specs).any? %>
      <ul class="mt-2 grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] text-ink-600 dark:text-ink-300">
        <% specs.each do |spec| %><li class="truncate rounded bg-ink-50 px-1.5 py-0.5 dark:bg-ink-800"><%= spec %></li><% end %>
      </ul>
    <% end %>
    <% if show_specs && listing.performance_score.present? %>
      <div class="mt-2 space-y-1 text-[11px] text-ink-500">
        <div class="flex justify-between"><span><%= t("listings.card.performance") %></span><span class="font-semibold text-ink-700 dark:text-ink-200"><%= number_with_delimiter(listing.performance_score) %></span></div>
        <%= performance_bar(listing.performance_score, max: 30_000) %>
        <div class="flex justify-between pt-1"><span><%= t("listings.card.value") %></span><span class="font-semibold text-ink-700 dark:text-ink-200"><%= listing.price_to_performance %></span></div>
        <%= performance_bar(listing.price_to_performance.to_f, max: 15, css: "bg-accent-500") %>
      </div>
    <% end %>
  </div>
</article>
