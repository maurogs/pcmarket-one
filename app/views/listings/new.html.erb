<% seo title: t(".title"), noindex: true %>
<div class="container-page max-w-4xl py-8">
  <h1 class="section-title"><%= t(".title") %></h1>
  <% if @listing.category.nil? || !@listing.category.leaf? %>
    <%= render "listings/category_picker", categories: @categories, path: ->(category) { new_listing_path(category_id: category.id) } %>
  <% else %>
    <%= render "listings/form", listing: @listing %>
  <% end %>
</div>
