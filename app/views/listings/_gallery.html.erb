<%# locals: (listing:) %>
<% photos = listing.photos.to_a %>
<div class="grid gap-3 sm:grid-cols-[72px_1fr]" data-controller="gallery" data-action="keydown->gallery#keydown">
  <% if photos.size > 1 %>
    <ul class="flex gap-2 overflow-x-auto max-sm:order-2 sm:flex-col sm:overflow-y-auto sm:max-h-[520px]" aria-label="<%= t("listings.gallery.thumbnails") %>">
      <% photos.each_with_index do |photo, index| %>
        <li class="shrink-0">
          <button type="button" class="block size-16 overflow-hidden rounded-xl border-2 border-transparent aria-[current=true]:border-brand-600 sm:size-[72px]" data-gallery-target="thumb" data-index="<%= index %>" data-action="gallery#show" aria-current="<%= index.zero? %>" aria-label="<%= t("listings.gallery.photo", number: index + 1) %>">
            <%= image_tag photo.variant(:thumb), alt: "", loading: "lazy", class: "h-full w-full object-cover" if photo.variable? %>
          </button>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="relative <%= "sm:col-span-2" if photos.size <= 1 %>">
    <div class="flex aspect-[4/3] snap-x snap-mandatory overflow-x-auto overflow-y-hidden rounded-2xl bg-ink-100 dark:bg-ink-800 [scrollbar-width:none]" data-gallery-target="track" tabindex="0" aria-label="<%= t("listings.gallery.label") %>" aria-roledescription="carousel">
      <% if photos.any? %>
        <% photos.each_with_index do |photo, index| %>
          <figure class="h-full w-full shrink-0 snap-start" data-index="<%= index %>">
            <%= image_tag photo.variant(:large), alt: t("listings.gallery.alt", title: listing.title, number: index + 1), class: "h-full w-full object-contain", loading: index.zero? ? "eager" : "lazy", fetchpriority: (index.zero? ? "high" : nil), decoding: "async" if photo.variable? %>
          </figure>
        <% end %>
      <% else %>
        <div class="grid h-full w-full place-items-center text-ink-400"><%= icon(:package, css: "size-16") %></div>
      <% end %>
    </div>
    <% if photos.size > 1 %>
      <button type="button" class="absolute left-3 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 shadow dark:bg-ink-900/90" data-action="gallery#previous" aria-label="<%= t("listings.gallery.previous") %>"><%= icon(:chevron_left) %></button>
      <button type="button" class="absolute right-3 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 shadow dark:bg-ink-900/90" data-action="gallery#next" aria-label="<%= t("listings.gallery.next") %>"><%= icon(:chevron_right) %></button>
      <span class="absolute bottom-3 right-3 rounded-full bg-ink-950/70 px-2.5 py-1 text-xs font-semibold text-white" data-gallery-target="counter" aria-live="polite">1 / <%= photos.size %></span>
    <% end %>
    <div class="absolute left-3 top-3"><%= listing_badge(listing) %></div>
  </div>
</div>
