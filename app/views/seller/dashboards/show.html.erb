<% seo title: t(".title"), noindex: true %>
<div class="container-page py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="section-title"><%= t(".title") %></h1>
    <%= link_to t("layout.list_item"), new_listing_path, class: "btn-primary" %>
  </div>
  <div class="mt-6 flex flex-col gap-6 lg:flex-row">
    <%= render "shared/account_nav", section: :seller %>
    <div class="flex-1 space-y-6">
      <% unless current_user.confirmed? %><p class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-100"><%= t("errors.confirm_email_first") %></p><% end %>
      <nav class="flex gap-2" aria-label="<%= t(".period") %>">
        <% SellerStats::PERIODS.each_key do |period| %><%= link_to t(".periods.#{period}"), seller_dashboard_path(period: period), class: "chip #{'chip-active' if @stats.period == period}" %><% end %>
      </nav>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <% [[t(".revenue"), money(@stats.revenue_cents)], [t(".orders"), @stats.orders_count], [t(".views"), number_with_delimiter(@stats.views)], [t(".favorites"), @stats.favorites]].each do |label, value| %>
          <div class="panel p-4"><p class="text-xs text-ink-500"><%= label %></p><p class="mt-1 text-2xl font-bold"><%= value %></p></div>
        <% end %>
      </div>
      <% series = @stats.revenue_by_day %>
      <% max = [series.map(&:last).max.to_i, 1].max %>
      <section class="panel">
        <h2 class="font-semibold"><%= t(".revenue_chart") %></h2>
        <div class="mt-4 flex h-32 items-end gap-0.5" role="img" aria-label="<%= t(".revenue_chart") %>">
          <% series.each do |day, cents| %><div class="flex-1 rounded-t bg-brand-500/80" style="height: <%= [(cents * 100.0 / max).round, 2].max %>%" title="<%= l(day, format: :short) %>: <%= money(cents) %>"></div><% end %>
        </div>
      </section>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% [[t(".to_ship"), @stats.pending_shipments, seller_sales_path(status: :paid)], [t(".disputes"), @stats.open_disputes, seller_sales_path(status: :disputed)],
            [t(".pending_review"), @stats.pending_listings, seller_listings_path(status: :pending_review)], [t(".offers"), @stats.unanswered_offers, conversations_path(tab: :offers)]].each do |label, value, path| %>
          <%= link_to path, class: "panel flex items-center justify-between p-4 hover:border-brand-500" do %><span class="text-sm"><%= label %></span><span class="text-xl font-bold <%= 'text-accent-600' if value.positive? %>"><%= value %></span><% end %>
        <% end %>
      </div>
      <section class="panel">
        <h2 class="font-semibold"><%= t(".vacation") %></h2>
        <%= form_with url: seller_vacation_path, method: :patch, class: "mt-3 flex flex-col gap-3 sm:flex-row sm:items-center" do %>
          <label class="flex items-center gap-2 text-sm"><input type="hidden" name="vacation_mode" value="0"><input type="checkbox" name="vacation_mode" value="1" class="checkbox" <%= "checked" if current_user.vacation_mode? %>><%= t(".vacation_toggle") %></label>
          <input name="vacation_message" value="<%= current_user.vacation_message %>" class="input" maxlength="200" placeholder="<%= t(".vacation_message") %>" aria-label="<%= t(".vacation_message") %>">
          <button class="btn-outline btn-sm shrink-0"><%= t("shared.save") %></button>
        <% end %>
      </section>
      <section class="panel">
        <h2 class="font-semibold"><%= t(".top_listings") %></h2>
        <table class="table mt-3"><thead><tr><th><%= t(".listing") %></th><th class="text-right"><%= t(".views") %></th><th class="text-right"><%= t(".favorites") %></th></tr></thead>
          <tbody><% @stats.top_listings.each do |listing| %><tr><td><%= link_to listing.title.truncate(60), listing_path(listing), class: "hover:text-brand-700" %></td><td class="text-right"><%= listing.views_count %></td><td class="text-right"><%= listing.favorites_count %></td></tr><% end %></tbody></table>
      </section>
      <section class="panel text-sm">
        <h2 class="font-semibold"><%= t(".payouts") %></h2>
        <p class="mt-1 text-ink-600 dark:text-ink-300"><%= t(".payouts_body", days: setting(:buyer_protection_days)) %></p>
      </section>
    </div>
  </div>
</div>
