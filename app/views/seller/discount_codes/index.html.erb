<% seo title: t(".title"), noindex: true %>
<div class="container-page py-8">
  <h1 class="section-title"><%= t(".title") %></h1>
  <div class="mt-6 flex flex-col gap-6 lg:flex-row">
    <%= render "shared/account_nav", section: :seller %>
    <div class="min-w-0 flex-1 space-y-6">
      <%= form_with model: @discount_code, url: seller_discount_codes_path, class: "panel grid gap-3 sm:grid-cols-5 sm:items-end" do |f| %>
        <% if @discount_code.errors.any? %><p class="field-error sm:col-span-5"><%= @discount_code.errors.full_messages.to_sentence %></p><% end %>
        <div class="sm:col-span-2"><%= f.label :code, class: "label" %><%= f.text_field :code, class: "input uppercase", required: true, maxlength: 20 %></div>
        <div><%= f.label :percent_off, class: "label" %><%= f.number_field :percent_off, min: 1, max: 90, class: "input", required: true %></div>
        <div><%= f.label :max_uses, class: "label" %><%= f.number_field :max_uses, min: 1, class: "input" %></div>
        <div><%= f.label :expires_at, class: "label" %><%= f.date_field :expires_at, class: "input" %></div>
        <button class="btn-primary sm:col-span-5 sm:justify-self-end"><%= t(".create") %></button>
      <% end %>
      <div class="panel overflow-x-auto p-0">
        <table class="table"><thead><tr><th><%= t(".code") %></th><th><%= t(".discount") %></th><th><%= t(".uses") %></th><th><%= t(".expires") %></th><th></th></tr></thead>
          <tbody><% @discount_codes.each do |code| %>
            <tr><td class="font-mono font-semibold"><%= code.code %></td><td><%= code.percent_off %>%</td><td><%= code.uses_count %><%= " / #{code.max_uses}" if code.max_uses %></td><td><%= code.expires_at ? l(code.expires_at.to_date) : "—" %></td>
              <td class="whitespace-nowrap text-right"><%= button_to (code.active? ? t(".deactivate") : t(".activate")), seller_discount_code_path(code), method: :patch, params: { active: code.active? ? "0" : "1" }, class: "link text-sm", form_class: "inline" %>
                <%= button_to t("shared.delete"), seller_discount_code_path(code), method: :delete, class: "link ml-2 text-sm text-red-700", form_class: "inline" %></td></tr>
          <% end %></tbody></table>
      </div>
    </div>
  </div>
</div>
