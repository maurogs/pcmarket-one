<% if feature?(:google_login_enabled) && Devise.omniauth_configs.key?(:google_oauth2) %>
  <div class="my-6 flex items-center gap-3 text-xs text-ink-400"><span class="h-px flex-1 bg-ink-200 dark:bg-ink-800"></span><%= t("auth.or") %><span class="h-px flex-1 bg-ink-200 dark:bg-ink-800"></span></div>
  <%= button_to user_google_oauth2_omniauth_authorize_path, class: "btn-outline w-full", data: { turbo: false } do %>
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8l3.7-2.8z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4z"/></svg>
    <%= t("devise.shared.links.sign_in_with_provider", provider: "Google") %>
  <% end %>
<% end %>
