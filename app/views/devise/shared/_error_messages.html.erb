<% if resource.errors.any? %>
  <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-900 dark:border-red-900 dark:bg-red-950 dark:text-red-100" role="alert">
    <ul class="list-disc pl-5"><% resource.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
