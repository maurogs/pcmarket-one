<%= render "devise/shared/auth_layout", title: t("auth.sign_up_title") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :first_name, class: "label" %><%= f.text_field :first_name, autocomplete: "given-name", class: "input" %></div>
      <div><%= f.label :last_name, class: "label" %><%= f.text_field :last_name, autocomplete: "family-name", class: "input" %></div>
    </div>
    <div><%= f.label :username, class: "label" %><%= f.text_field :username, class: "input", pattern: "[a-zA-Z0-9_\\-.]{3,30}", placeholder: t("auth.username_placeholder") %><p class="hint"><%= t("auth.username_hint") %></p></div>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autocomplete: "email", required: true, class: "input" %></div>
    <div><%= f.label :password, class: "label" %><%= f.password_field :password, autocomplete: "new-password", required: true, minlength: @minimum_password_length, class: "input" %>
      <% if @minimum_password_length %><p class="hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p><% end %></div>
    <div><%= f.label :password_confirmation, class: "label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input" %></div>
    <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="user[terms_accepted]" value="1" class="checkbox mt-0.5" required>
      <span><%= t("auth.terms_html", terms: link_to(t("legal.terms.title"), legal_page_path("terms"), class: "link", target: "_blank"), privacy: link_to(t("legal.privacy.title"), legal_page_path("privacy"), class: "link", target: "_blank")) %></span></label>
    <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="user[marketing_consent]" value="1" class="checkbox mt-0.5"><span><%= t("auth.marketing_consent") %></span></label>
    <p class="text-xs text-ink-500"><%= t("auth.age_notice") %></p>
    <%= f.submit t("devise.registrations.new.sign_up"), class: "btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/oauth" %>
  <%= render "devise/shared/links" %>
<% end %>
