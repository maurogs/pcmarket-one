<%= render "devise/shared/auth_layout", title: t("devise.confirmations.new.resend_confirmation_instructions") do %>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input", value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %></div>
    <%= f.submit t("devise.confirmations.new.resend_confirmation_instructions"), class: "btn-primary w-full" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
