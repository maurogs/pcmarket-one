<% seo title: t(".title", name: @store.display_name) %>
<div class="container-page max-w-4xl py-8">
  <%= link_to store_path(@store), class: "link inline-flex items-center gap-1 text-sm" do %><%= icon(:chevron_left, css: "size-4") %><%= @store.display_name %><% end %>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="section-title"><%= t(".title", name: @store.display_name) %></h1>
      <p class="mt-2 flex items-center gap-2"><span class="text-4xl font-bold"><%= number_with_precision(@store.rating_avg, precision: 1) %></span><%= stars(@store.rating_avg, css: "size-5") %><span class="text-sm text-ink-500"><%= t("stores.reviews_count", count: @store.reviews_count) %></span></p>
    </div>
    <%= form_with url: store_reviews_path(@store), method: :get, data: { controller: "autosubmit" } do %>
      <select name="order" class="input" aria-label="<%= t(".order") %>" data-action="change->autosubmit#submit">
        <option value="newest"><%= t(".newest") %></option><option value="oldest" <%= "selected" if params[:order] == "oldest" %>><%= t(".oldest") %></option>
      </select>
    <% end %>
  </div>
  <div class="mt-6 space-y-4">
    <% @reviews.each do |review| %><%= render "reviews/review", review: review %><% end %>
    <% if @reviews.empty? %><%= render "shared/empty_state", icon_name: :star, title: t("stores.no_reviews") %><% end %>
  </div>
  <%= pagination(@pagy) %>
</div>
