<% seo title: t(".title"), noindex: true %>
<% other = @conversation.other_participant(current_user) %>
<%= turbo_stream_from @conversation %>
<div class="container-page max-w-4xl py-6">
  <%= link_to conversations_path, class: "link inline-flex items-center gap-1 text-sm" do %><%= icon(:chevron_left, css: "size-4") %><%= t("conversations.index.title") %><% end %>
  <div class="mt-3 flex flex-col overflow-hidden rounded-2xl border border-ink-200 dark:border-ink-800" style="height: min(78dvh, 820px)" data-controller="chat" data-chat-user-id-value="<%= current_user.id %>">
    <header class="flex items-center gap-3 border-b border-ink-200 p-4 dark:border-ink-800">
      <%= link_to store_path(other) do %><%= avatar_for(other, size: 40) %><% end %>
      <div class="min-w-0 flex-1">
        <p class="truncate font-semibold"><%= link_to other.display_name, store_path(other), class: "hover:text-brand-700" %></p>
        <% if @conversation.listing %><p class="truncate text-xs text-ink-500"><%= link_to @conversation.listing.title, listing_path(@conversation.listing), class: "hover:text-brand-700" %> · <%= money(@conversation.listing.price_cents, @conversation.listing.currency) %></p><% end %>
      </div>
      <div class="flex items-center gap-1">
        <% if @conversation.listing&.available? && @conversation.role_of(current_user) == :buyer && @conversation.listing.allow_offers? && feature?(:offers_enabled) %>
          <%= link_to t(".make_offer"), new_listing_offer_path(@conversation.listing), class: "btn-outline btn-sm" %>
        <% end %>
        <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc->dropdown#close">
          <button type="button" class="btn-ghost btn-sm" data-dropdown-target="button" data-action="dropdown#toggle" aria-haspopup="menu" aria-expanded="false" aria-label="<%= t(".more") %>"><%= icon(:settings, css: "size-4") %></button>
          <div class="absolute right-0 z-20 mt-1 w-52 rounded-xl border border-ink-200 bg-white p-1 shadow-lg dark:border-ink-700 dark:bg-ink-900" data-dropdown-target="menu" hidden>
            <%= button_to t(".block"), blocks_path, params: { username: other.username }, class: "block w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-ink-100 dark:hover:bg-ink-800", data: { turbo_confirm: t(".block_confirm") } %>
            <%= link_to t(".report"), new_report_path(reportable_type: "User", reportable_id: other.id), class: "block rounded-lg px-3 py-2 text-sm hover:bg-ink-100 dark:hover:bg-ink-800" %>
          </div>
        </div>
      </div>
    </header>
    <div class="flex-1 space-y-3 overflow-y-auto bg-ink-50 p-4 dark:bg-ink-950" id="messages" data-chat-target="messages" role="log" aria-live="polite">
      <p class="mx-auto max-w-md rounded-xl bg-amber-50 p-3 text-center text-xs text-amber-900 dark:bg-amber-950 dark:text-amber-100"><%= icon(:shield, css: "mr-1 inline size-3.5") %><%= t(".safety_notice", site: site_name) %></p>
      <% @messages.each do |message| %><%= render "messages/message", message: message, viewer: current_user %><% end %>
    </div>
    <% if @conversation.blocked? %>
      <p class="border-t border-ink-200 p-4 text-center text-sm text-ink-500 dark:border-ink-800"><%= t(".blocked") %></p>
    <% else %>
      <%= form_with model: [@conversation, Message.new], class: "flex items-end gap-2 border-t border-ink-200 p-3 dark:border-ink-800", data: { chat_target: "form", action: "turbo:submit-end->chat#reset" } do |f| %>
        <%= f.label :body, t(".placeholder"), class: "sr-only" %>
        <%= f.text_area :body, rows: 1, maxlength: Message::MAX_LENGTH, required: true, placeholder: t(".placeholder"), class: "input max-h-40 resize-none", data: { chat_target: "input", action: "keydown->chat#submitOnEnter" } %>
        <button class="btn-primary shrink-0 px-4" aria-label="<%= t(".send") %>"><%= t(".send") %></button>
      <% end %>
    <% end %>
  </div>
</div>
