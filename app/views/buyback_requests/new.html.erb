<% seo title: t(".title"), description: t(".subtitle") %>
<div class="container-page py-10">
  <section class="rounded-3xl bg-gradient-to-br from-accent-400/30 to-brand-100 p-8 text-center sm:p-14 dark:from-accent-500/20 dark:to-brand-950">
    <span class="text-xs font-bold uppercase tracking-widest text-brand-800 dark:text-brand-300"><%= t("layout.sell_to_us") %></span>
    <h1 class="mt-2 text-4xl font-bold sm:text-5xl"><%= t(".title") %></h1>
    <p class="mx-auto mt-3 max-w-xl text-ink-700 dark:text-ink-300"><%= t(".subtitle") %></p>
  </section>
  <div class="mt-10 grid gap-8 lg:grid-cols-2">
    <section class="panel">
      <h2 class="font-display text-xl font-bold"><%= t(".get_offer") %></h2>
      <% if user_signed_in? %>
        <%= form_with model: @request, url: buyback_requests_path, class: "mt-4 space-y-4" do |f| %>
          <% if @request.errors.any? %><p class="field-error"><%= @request.errors.full_messages.to_sentence %></p><% end %>
          <div><%= f.label :filter_option_id, t(".model"), class: "label" %><%= f.select :filter_option_id, @options.map { |o| ["#{o.label} — #{money(o.buyback_cents)}", o.id] }, { include_blank: t("listings.form.select") }, class: "input", required: true %></div>
          <div><%= f.label :condition, t(".condition"), class: "label" %><%= f.select :condition, BuybackRequest.conditions.keys.map { |c| [t(".conditions.#{c}"), c] }, {}, class: "input" %></div>
          <div><%= f.label :paypal_email, t(".payout_email"), class: "label" %><%= f.email_field :paypal_email, class: "input" %></div>
          <div><%= f.label :notes, t(".notes"), class: "label" %><%= f.text_area :notes, rows: 3, class: "input" %></div>
          <button class="btn-primary w-full"><%= t(".submit") %></button>
        <% end %>
      <% else %>
        <p class="mt-3 text-sm"><%= t(".login_required") %></p><%= link_to t("layout.log_in"), new_user_session_path, class: "btn-primary mt-4" %>
      <% end %>
    </section>
    <section>
      <h2 class="font-display text-xl font-bold"><%= t(".how_it_works") %></h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-2">
        <% 4.times do |i| %><li class="panel p-4"><p class="font-semibold"><%= i + 1 %>. <%= t(".steps.s#{i + 1}.title") %></p><p class="mt-1 text-sm text-ink-600 dark:text-ink-300"><%= t(".steps.s#{i + 1}.body") %></p></li><% end %>
      </ol>
      <h3 class="mt-8 font-semibold"><%= t(".price_list") %></h3>
      <table class="table mt-2"><tbody><% @options.first(10).each do |option| %><tr><td><%= option.label %></td><td class="text-right font-semibold"><%= money(option.buyback_cents) %></td></tr><% end %></tbody></table>
    </section>
  </div>
</div>
