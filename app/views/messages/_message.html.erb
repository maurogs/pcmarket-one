<%# locals: (message:, viewer: nil) %>
<% if message.system? %>
  <p id="<%= dom_id(message) %>" class="text-center text-xs font-semibold text-ink-500"><%= t("messages.system.#{message.body}", default: message.body) %> · <%= l(message.created_at, format: :short) %></p>
<% else %>
  <div id="<%= dom_id(message) %>" class="group flex max-w-[85%] flex-col data-[own=true]:ml-auto data-[own=true]:items-end" data-sender-id="<%= message.sender_id %>" data-own="<%= viewer && viewer.id == message.sender_id %>">
    <% if message.offer? && message.offer %>
      <% offer = message.offer %>
      <div class="rounded-2xl border-2 border-accent-400 bg-white p-4 dark:bg-ink-900">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent-600"><%= t("messages.offer.title") %></p>
        <p class="mt-1 text-2xl font-bold"><%= money(offer.amount_cents, offer.listing.currency) %></p>
        <p class="text-xs text-ink-500"><%= t("messages.offer.listed_at", price: money(offer.listing.price_cents, offer.listing.currency)) %> · <%= t("offers.statuses.#{offer.status}") %></p>
        <% if offer.pending? %>
          <p class="mt-1 text-xs text-ink-500"><%= t("messages.offer.expires", time: l(offer.expires_at, format: :short)) %></p>
          <div class="mt-3 flex gap-2" data-visible-to="<%= offer.seller_id %>" <%= "hidden" unless viewer&.id == offer.seller_id %>>
            <%= button_to t("messages.offer.accept"), offer_path(offer), method: :patch, params: { decision: "accept" }, class: "btn-primary btn-sm" %>
            <%= button_to t("messages.offer.decline"), offer_path(offer), method: :patch, params: { decision: "decline" }, class: "btn-outline btn-sm" %>
          </div>
          <div class="mt-3" data-visible-to="<%= offer.buyer_id %>" <%= "hidden" unless viewer&.id == offer.buyer_id %>>
            <%= button_to t("messages.offer.withdraw"), offer_path(offer), method: :patch, params: { decision: "withdraw" }, class: "btn-ghost btn-sm" %>
          </div>
        <% elsif offer.accepted? %>
          <div class="mt-3" data-visible-to="<%= offer.buyer_id %>" <%= "hidden" unless viewer&.id == offer.buyer_id %>>
            <%= button_to t("messages.offer.buy"), cart_items_path, params: { listing_id: offer.listing_id, offer_id: offer.id, buy_now: 1 }, class: "btn-accent btn-sm", form: { data: { turbo: false } } %>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if message.body.present? %>
      <div class="rounded-2xl rounded-bl-md bg-white px-4 py-2.5 text-sm shadow-sm group-data-[own=true]:rounded-bl-2xl group-data-[own=true]:rounded-br-md group-data-[own=true]:bg-brand-700 group-data-[own=true]:text-white dark:bg-ink-800">
        <p class="whitespace-pre-line break-words"><%= message.body %></p>
      </div>
    <% end %>
    <% if message.off_platform_warning? %><p class="mt-1 text-[11px] text-amber-700 dark:text-amber-300"><%= icon(:alert, css: "mr-0.5 inline size-3") %><%= t("messages.off_platform_warning") %></p><% end %>
    <span class="mt-1 text-[11px] text-ink-400"><%= l(message.created_at, format: :short) %></span>
  </div>
<% end %>
