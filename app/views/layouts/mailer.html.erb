<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head><meta http-equiv="Content-Type" content="text/html; charset=utf-8"><meta name="viewport" content="width=device-width"></head>
  <body style="margin:0;background:#f6f7f9;font-family:-apple-system,'Segoe UI',Inter,Arial,sans-serif;color:#1a1e29">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f7f9;padding:24px 12px">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden">
          <tr><td style="background:#067d74;padding:20px 28px;color:#ffffff;font-size:20px;font-weight:700"><%= Setting.get(:site_name) %></td></tr>
          <tr><td style="padding:28px;font-size:15px;line-height:1.6"><%= yield %></td></tr>
          <tr><td style="padding:20px 28px;border-top:1px solid #eceef2;font-size:12px;color:#667491">
            <%= t("mailers.footer", site: Setting.get(:site_name)) %><br>
            <a href="<%= edit_account_notification_settings_url %>" style="color:#067d74"><%= t("mailers.manage_notifications") %></a>
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
