<!DOCTYPE html>
<html lang="<%= I18n.locale == :en ? "en-GB" : I18n.locale %>" class="scroll-smooth" data-controller="theme">
  <head>
    <% meta = seo_data %>
    <title><%= meta[:title] %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="<%= meta[:description] %>">
    <meta name="robots" content="<%= meta[:noindex] ? "noindex,follow" : "index,follow,max-image-preview:large" %>">
    <link rel="canonical" href="<%= meta[:canonical] %>">
    <%= hreflang_links %>
    <meta property="og:site_name" content="<%= site_name %>">
    <meta property="og:type" content="<%= meta[:type] %>">
    <meta property="og:title" content="<%= meta[:title] %>">
    <meta property="og:description" content="<%= meta[:description] %>">
    <meta property="og:url" content="<%= meta[:canonical] %>">
    <meta property="og:image" content="<%= meta[:image] %>">
    <meta property="og:locale" content="<%= t("seo.og_locale") %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="theme-color" content="#067d74" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0e1118" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="preload" href="<%= asset_path("inter-latin-wght-normal.woff2") %>" as="font" type="font/woff2" crossorigin>
    <script>
      try { var t = localStorage.getItem("theme"); if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark") } catch (e) {}
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script type="application/ld+json"><%= raw json_escape(organization_json_ld.to_json) %></script>
    <% Array(@json_ld).each do |data| %>
      <script type="application/ld+json"><%= raw json_escape(data.to_json) %></script>
    <% end %>
    <%= yield :head %>
  </head>

  <body class="flex min-h-dvh flex-col" data-controller="cookie-consent">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn-primary"><%= t("layout.skip_to_content") %></a>
    <% if user_signed_in? %><%= turbo_stream_from current_user, :notifications %><% end %>
    <%= render "shared/announcement" %>
    <%= render "shared/header" %>
    <%= render "shared/flash" %>
    <main id="main" class="flex-1">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
    <%= render "shared/cookie_consent" %>
    <a href="#main" class="fixed bottom-5 left-5 z-30 hidden size-11 place-items-center rounded-full border border-ink-200 bg-white shadow-lg sm:grid dark:border-ink-700 dark:bg-ink-900" aria-label="<%= t("layout.back_to_top") %>" data-controller="back-to-top" data-back-to-top-target="button" hidden><%= icon(:arrow_up) %></a>
  </body>
</html>
