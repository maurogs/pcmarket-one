<% seo title: t("pages.credits.title"), noindex: true %>
<div class="container-page max-w-4xl py-10">
  <h1 class="text-4xl font-bold"><%= t("pages.credits.title") %></h1>
  <p class="mt-3 text-ink-600 dark:text-ink-300"><%= t("pages.credits.intro") %></p>
  <table class="table mt-6"><thead><tr><th><%= t("pages.credits.image") %></th><th><%= t("pages.credits.author") %></th><th><%= t("pages.credits.source") %></th><th><%= t("pages.credits.license") %></th></tr></thead>
    <tbody><% @credits.each do |credit| %><tr><td><%= credit.title.to_s.truncate(50) %></td><td><%= credit.creator %></td><td><%= link_to credit.source, credit.source_url, class: "link", rel: "nofollow noopener", target: "_blank" %></td><td><%= credit.license_url.present? ? link_to(credit.license, credit.license_url, class: "link", rel: "nofollow noopener", target: "_blank") : credit.license %></td></tr><% end %></tbody></table>
</div>
