<% seo title: t("pages.sell.title"), description: t("pages.sell.intro", site: site_name) %>
<div class="container-page py-10">
  <section class="grid items-center gap-8 rounded-3xl bg-gradient-to-br from-accent-400/30 via-white to-brand-100 p-8 sm:p-14 lg:grid-cols-2 dark:from-accent-500/20 dark:via-ink-950 dark:to-brand-950">
    <div>
      <h1 class="text-4xl font-bold sm:text-5xl"><%= t("pages.sell.hero_title", site: site_name) %></h1>
      <p class="mt-4 text-lg text-ink-700 dark:text-ink-300"><%= t("pages.sell.intro", site: site_name) %></p>
      <%= link_to t("pages.sell.cta"), new_listing_path, class: "btn-primary mt-8" %>
    </div>
    <ul class="grid grid-cols-2 gap-3 text-sm">
      <% [[:euro, :fees], [:shield, :protection], [:message, :chat], [:store, :stores]].each do |icon_name, key| %>
        <li class="rounded-2xl bg-white/80 p-4 dark:bg-ink-900/70"><%= icon(icon_name, css: "size-6 text-brand-700") %><p class="mt-2 font-semibold"><%= t("pages.sell.perks.#{key}.title") %></p><p class="mt-1 text-ink-600 dark:text-ink-300"><%= t("pages.sell.perks.#{key}.body", percent: setting(:commission_percent)) %></p></li>
      <% end %>
    </ul>
  </section>
  <section class="mt-14">
    <h2 class="section-title"><%= t("pages.sell.how_title") %></h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-4">
      <% %w[list review sell paid].each_with_index do |step, index| %>
        <li class="panel"><span class="grid size-8 place-items-center rounded-full bg-brand-700 text-sm font-bold text-white"><%= index + 1 %></span><h3 class="mt-3 font-display font-bold"><%= t("pages.sell.steps.#{step}.title") %></h3><p class="mt-1 text-sm text-ink-600 dark:text-ink-300"><%= t("pages.sell.steps.#{step}.body", days: setting(:buyer_protection_days), ship_days: setting(:seller_ship_days)) %></p></li>
      <% end %>
    </ol>
  </section>
  <section class="mx-auto mt-14 max-w-3xl">
    <h2 class="section-title"><%= t("pages.sell.faq_title") %></h2>
    <div class="mt-5 divide-y divide-ink-200 border-y border-ink-200 dark:divide-ink-800 dark:border-ink-800">
      <% t("pages.sell.faqs").each do |_key, faq| %>
        <details class="group py-4"><summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg font-semibold"><%= faq[:q] %><%= icon(:plus, css: "size-5 shrink-0 transition group-open:rotate-45") %></summary><p class="mt-3 text-ink-700 dark:text-ink-300"><%= faq[:a] %></p></details>
      <% end %>
    </div>
  </section>
  <%= render "shared/listing_row", title: t("pages.sell.recently_sold"), listings: @recently_sold.to_a %>
  <section class="mt-14 rounded-3xl bg-brand-950 p-10 text-center text-white">
    <h2 class="text-3xl font-bold"><%= t("pages.sell.final_title") %></h2>
    <%= link_to t("pages.sell.cta"), new_listing_path, class: "btn-accent mt-6" %>
  </section>
</div>
