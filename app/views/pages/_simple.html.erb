<%# locals: (page:) %>
<% seo title: t("pages.#{page}.title"), description: t("pages.#{page}.intro") %>
<div class="container-page max-w-3xl py-10">
  <h1 class="text-4xl font-bold"><%= t("pages.#{page}.title") %></h1>
  <p class="mt-3 text-lg text-ink-600 dark:text-ink-300"><%= t("pages.#{page}.intro") %></p>
  <div class="mt-8 space-y-8">
    <% t("pages.#{page}.sections").each do |_key, section| %>
      <section><h2 class="font-display text-2xl font-bold"><%= section[:heading] %></h2>
        <% Array(section[:body]).each do |paragraph| %><p class="mt-3 leading-relaxed text-ink-700 dark:text-ink-300"><%= paragraph %></p><% end %></section>
    <% end %>
  </div>
  <%= yield %>
</div>
