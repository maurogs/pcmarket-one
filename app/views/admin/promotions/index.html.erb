<%= render "admin/shared/page_header", title: t("admin.nav.promotions"), subtitle: feature?(:promotions_enabled) ? t("admin.on") : t("admin.promotions.disabled") %>
<div class="panel overflow-x-auto p-0"><table class="table"><thead><tr><th><%= t("admin.listings.listing") %></th><th><%= t("admin.users.user") %></th><th><%= t("admin.promotions.period") %></th><th class="text-right"><%= t("admin.listings.price") %></th><th><%= t("admin.listings.status") %></th><th></th></tr></thead>
  <tbody><% @promotions.each do |p| %><tr><td><%= link_to p.listing.title.truncate(50), admin_listing_path(p.listing), class: "link" %></td><td><%= p.user.username %></td><td class="text-xs"><%= l(p.starts_at.to_date) %> → <%= l(p.ends_at.to_date) %></td><td class="text-right"><%= money(p.price_cents) %></td><td><%= status_badge(p.status, "admin.promotions.statuses") %></td>
    <td class="whitespace-nowrap text-right"><% if p.pending? %><%= button_to t("admin.promotions.activate"), admin_promotion_path(p), method: :patch, params: { status: "active" }, class: "link text-sm", form_class: "inline" %><% end %><% if p.pending? || p.active? %><%= button_to t("shared.cancel"), admin_promotion_path(p), method: :patch, params: { status: "cancelled" }, class: "link ml-2 text-sm text-red-700", form_class: "inline" %><% end %></td></tr><% end %></tbody></table></div>
<%= pagination(@pagy) %>
