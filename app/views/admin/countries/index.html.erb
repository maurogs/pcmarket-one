<%= render "admin/shared/page_header", title: t("admin.nav.countries"), subtitle: t("admin.countries.subtitle") %>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @countries.each do |country| %>
    <section class="panel">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-bold"><%= country.name %> <span class="font-mono text-xs text-ink-400"><%= country.code %></span></h2>
        <%= form_with model: country, url: admin_country_path(country), method: :patch do |f| %>
          <%= f.hidden_field :enabled, value: !country.enabled %>
          <button class="relative inline-flex h-7 w-12 items-center rounded-full transition <%= country.enabled ? 'bg-brand-600' : 'bg-ink-300 dark:bg-ink-700' %>" role="switch" aria-checked="<%= country.enabled %>" aria-label="<%= t("admin.countries.toggle", country: country.name) %>" data-turbo-confirm="<%= country.enabled ? t("admin.countries.disable_confirm", country: country.name) : t("admin.countries.enable_confirm", country: country.name) %>">
            <span class="inline-block size-5 rounded-full bg-white shadow transition <%= country.enabled ? 'translate-x-6' : 'translate-x-1' %>"></span>
          </button>
        <% end %>
      </div>
      <dl class="mt-3 grid grid-cols-2 gap-1 text-sm">
        <dt class="text-ink-500"><%= t("admin.countries.currency") %></dt><dd><%= country.currency %></dd>
        <dt class="text-ink-500"><%= t("admin.countries.vat") %></dt><dd><%= country.vat_rate %>%</dd>
        <dt class="text-ink-500"><%= t("admin.countries.locale") %></dt><dd><%= t("locales.#{country.default_locale}") %></dd>
        <dt class="text-ink-500"><%= t("admin.countries.regions") %></dt><dd><%= country.regions.size %></dd>
        <dt class="text-ink-500"><%= t("admin.nav.listings") %></dt><dd><%= @listing_counts[country.id].to_i %></dd>
        <dt class="text-ink-500"><%= t("admin.nav.users") %></dt><dd><%= @user_counts[country.id].to_i %></dd>
      </dl>
      <div class="mt-4 flex gap-3 text-sm"><%= link_to t("admin.countries.edit_legal"), edit_admin_country_path(country), class: "link" %><%= link_to t("admin.countries.preview_legal"), legal_page_path("terms", country: country.code), class: "link", target: "_blank" if country.enabled %></div>
    </section>
  <% end %>
</div>
<p class="mt-6 max-w-3xl text-sm text-ink-500"><%= t("admin.countries.launch_checklist") %></p>
