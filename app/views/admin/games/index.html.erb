<%= render "admin/shared/page_header", title: t("admin.nav.games"), subtitle: t("admin.games.subtitle") do %><%= link_to t("admin.new"), new_admin_game_path, class: "btn-primary btn-sm" %><% end %>
<div class="panel overflow-x-auto p-0"><table class="table"><thead><tr><th><%= t("admin.games.name") %></th><th class="text-right"><%= t("admin.games.demand") %></th><th><%= t("admin.categories.flags") %></th><th></th></tr></thead>
  <tbody><% @games.each do |game| %><tr><td><%= game.name %></td><td class="text-right"><%= game.demand %></td><td><%= tag.span(t("admin.categories.inactive"), class: "badge-danger") unless game.active %></td><td class="text-right"><%= link_to t("shared.edit"), edit_admin_game_path(game), class: "link text-sm" %></td></tr><% end %></tbody></table></div>
