<%= form_with model: [:admin, @game], class: "panel max-w-2xl space-y-4" do |f| %>
  <%= render "admin/shared/errors", record: @game %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", required: true %></div>
    <div><%= f.label :slug, class: "label" %><%= f.text_field :slug, class: "input", required: true %></div>
    <div><%= f.label :demand, t("admin.games.demand"), class: "label" %><%= f.number_field :demand, class: "input", min: 10, max: 1000 %><p class="hint"><%= t("admin.games.demand_hint") %></p></div>
    <div><%= f.label :position, class: "label" %><%= f.number_field :position, class: "input" %></div>
    <div><%= f.label :cover, class: "label" %><%= f.file_field :cover, accept: "image/*", class: "input py-2" %></div>
    <label class="flex items-center gap-2 self-end text-sm"><%= f.check_box :active, class: "checkbox" %><%= t("admin.categories.active") %></label>
  </div>
  <div class="flex justify-between gap-2">
    <% if @game.persisted? %><%= link_to t("shared.delete"), admin_game_path(@game), class: "btn-ghost text-red-700", data: { turbo_method: :delete, turbo_confirm: t("shared.confirm") } %><% else %><span></span><% end %>
    <div class="flex gap-2"><%= link_to t("shared.cancel"), admin_games_path, class: "btn-ghost" %><button class="btn-primary"><%= t("shared.save") %></button></div>
  </div>
<% end %>
