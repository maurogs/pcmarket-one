<%= render "admin/shared/page_header", title: @order.number, subtitle: l(@order.created_at, format: :long) %>
<div class="grid gap-4 lg:grid-cols-[1fr_360px]">
  <div class="space-y-4">
    <section class="panel">
      <div class="flex items-center gap-3"><%= status_badge(@order.status, "orders.statuses") %><span class="text-sm text-ink-500"><%= t("orders.show.delivery") %>: <%= t("admin.orders.delivery.#{@order.delivery_method}") %> · <%= @order.payment_provider %> <%= @order.payment_reference %></span></div>
      <table class="table mt-3"><tbody><% @order.items.each do |item| %><tr><td><%= link_to item.title, admin_listing_path(item.listing), class: "hover:text-brand-700" %></td><td>× <%= item.quantity %></td><td class="text-right"><%= money(item.total_cents, @order.currency) %></td></tr><% end %></tbody></table>
      <dl class="mt-3 grid grid-cols-2 gap-1 text-sm sm:grid-cols-5">
        <% %i[subtotal shipping discount platform_fee total].each do |key| %><div><dt class="text-xs text-ink-500"><%= t("admin.orders.amounts.#{key}") %></dt><dd class="font-semibold"><%= money(@order.public_send("#{key}_cents"), @order.currency) %></dd></div><% end %>
      </dl>
    </section>
    <% if @order.dispute_reason.present? || @order.cancel_reason.present? %>
      <section class="panel border-amber-300"><h2 class="font-semibold"><%= t("admin.orders.reasons") %></h2><p class="mt-1 whitespace-pre-line text-sm"><%= [@order.dispute_reason, @order.cancel_reason].compact_blank.join("\n\n") %></p></section>
    <% end %>
    <section class="panel"><h2 class="font-semibold"><%= t("orders.show.timeline") %></h2>
      <ol class="mt-2 space-y-1 text-sm"><% @events.each do |event| %><li><strong><%= t("orders.statuses.#{event.to_status}") %></strong> · <%= event.actor&.username || t("admin.system") %> · <%= l(event.created_at, format: :short) %><%= " · #{event.note}" if event.note.present? %></li><% end %></ol></section>
  </div>
  <aside class="space-y-4">
    <section class="panel text-sm">
      <p><span class="text-ink-500"><%= t("orders.show.buyer") %>:</span> <%= link_to @order.buyer.username, admin_user_path(@order.buyer), class: "link" %> (<%= @order.email %>)</p>
      <p class="mt-1"><span class="text-ink-500"><%= t("orders.show.seller") %>:</span> <%= link_to @order.seller.username, admin_user_path(@order.seller), class: "link" %></p>
      <% if @order.delivery_shipping? %><p class="mt-2 text-ink-600 dark:text-ink-300"><%= @order.shipping_address.values_at("full_name", "line1", "line2", "postal_code", "city", "region", "country_code", "phone").compact_blank.join(", ") %></p><% end %>
    </section>
    <section class="panel">
      <h2 class="font-semibold"><%= t("admin.orders.change_status") %></h2>
      <% targets = Order::TRANSITIONS.fetch(@order.status, []) %>
      <% if targets.any? %>
        <%= form_with url: admin_order_path(@order), method: :patch, class: "mt-3 space-y-2" do %>
          <select name="status" class="input" aria-label="<%= t("admin.orders.change_status") %>"><% targets.each do |target| %><option value="<%= target %>"><%= t("orders.statuses.#{target}") %></option><% end %></select>
          <textarea name="note" rows="2" class="input" placeholder="<%= t("admin.orders.note") %>" aria-label="<%= t("admin.orders.note") %>"></textarea>
          <button class="btn-primary btn-sm w-full" data-turbo-confirm="<%= t("shared.confirm") %>"><%= t("admin.orders.apply") %></button>
        <% end %>
      <% else %><p class="mt-2 text-sm text-ink-500"><%= t("admin.orders.final") %></p><% end %>
    </section>
    <section class="panel">
      <h2 class="font-semibold"><%= t("orders.show.tracking") %></h2>
      <%= form_with model: @order, url: admin_order_path(@order), method: :patch, class: "mt-3 space-y-2" do |f| %>
        <%= f.text_field :carrier, class: "input", placeholder: t("orders.actions.carrier") %><%= f.text_field :tracking_number, class: "input", placeholder: t("orders.actions.tracking") %>
        <button class="btn-outline btn-sm w-full"><%= t("shared.save") %></button>
      <% end %>
    </section>
  </aside>
</div>
