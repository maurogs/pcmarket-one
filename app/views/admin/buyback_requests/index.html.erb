<%= render "admin/shared/page_header", title: t("admin.nav.buyback"), subtitle: feature?(:sell_to_us_enabled) ? t("admin.on") : t("admin.buyback.disabled") %>
<div class="panel overflow-x-auto p-0"><table class="table"><thead><tr><th><%= t("admin.users.user") %></th><th><%= t("buyback_requests.new.model") %></th><th><%= t("buyback_requests.new.condition") %></th><th class="text-right"><%= t("admin.buyback.quote") %></th><th><%= t("admin.listings.status") %></th></tr></thead>
  <tbody><% @requests.each do |r| %><tr><td><%= link_to r.user.username, admin_user_path(r.user), class: "link" %></td><td><%= r.filter_option.label %></td><td><%= t("buyback_requests.new.conditions.#{r.condition}") %></td><td class="text-right"><%= money(r.quoted_cents) %></td>
    <td><%= form_with url: admin_buyback_request_path(r), method: :patch, data: { controller: "autosubmit" } do %><select name="status" class="input min-h-9 py-1 text-xs" data-action="change->autosubmit#submit" aria-label="<%= t("admin.listings.status") %>"><% BuybackRequest.statuses.each_key do |s| %><option value="<%= s %>" <%= "selected" if r.status == s %>><%= t("buyback_requests.statuses.#{s}") %></option><% end %></select><% end %></td></tr><% end %></tbody></table></div>
<%= pagination(@pagy) %>
