<h1 style="font-size:20px;margin:0 0 12px"><%= t("mailers.support.received.subject", id: @ticket.id) %></h1>
<p><%= t("mailers.support.received.body", name: @ticket.name) %></p>
<blockquote style="border-left:3px solid #06c4b0;margin:0;padding:8px 12px;background:#effefb"><strong><%= @ticket.subject %></strong><br><%= @ticket.body.truncate(800) %></blockquote>
